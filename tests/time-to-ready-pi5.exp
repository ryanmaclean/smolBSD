#!/usr/bin/env expect
# Physical board boot gate — Raspberry Pi 5 (BCM2712)
# Materialized from plans/tinyos/PHASE-2-PHYSICAL-BOOT.md §6-7
# Authoring chain: planner@smolfire.local <task-0023.coord@smolfire.local>
#
# tests/time-to-ready-pi5.exp
#
# Prerequisites:
#   - CP2102 or similar 3.3V USB-UART adapter connected to Pi 5 debug UART header
#   - Serial device available at $env(SMOLFIRE_SERIAL) or default /dev/ttyUSB0
#   - Board powered off before running; script powers on via human action or USB relay
#   - smolfire-aarch64-pi5.raw written to SD card (tests/sd-write.nu)
#
# Console: PL011 UART (Pi 5) — 115200 8N1
# Serial device: override with env var SMOLFIRE_SERIAL (e.g. /dev/tty.usbserial-0001)
#
# Acceptance: login prompt appears within 60s of first serial output
# (PHASE-2-PHYSICAL-BOOT.md §7.2 Pi 5 gate)
#
# Exit codes: 0 = pass, 1 = timeout or serial error

set threshold_sec 60
set timeout [expr {$threshold_sec + 10}]

# Resolve serial device: env var > default
if {[info exists env(SMOLFIRE_SERIAL)]} {
    set serial_dev $env(SMOLFIRE_SERIAL)
} else {
    set serial_dev /dev/ttyUSB0
}

# Verify device node exists before spawning
if {![file exists $serial_dev]} {
    puts stderr "ERROR: serial device $serial_dev not found"
    puts stderr "Set SMOLFIRE_SERIAL to override (e.g. /dev/tty.usbserial-0001)"
    exit 1
}

puts "BOARD=pi5"
puts "SERIAL_DEV=$serial_dev"
puts "THRESHOLD=${threshold_sec}s"
puts "--- power the board on now if not already running ---"

# Spawn cu against the serial port (115200 8N1, no flow control)
# cu is available on both macOS and FreeBSD (BSD-licensed)
# Alternative: replace with: spawn screen $serial_dev 115200
set t0 [clock seconds]
spawn cu -l $serial_dev -s 115200

expect {
    "login:" {
        set elapsed [expr {[clock seconds] - $t0}]
        puts "TIME_TO_LOGIN=${elapsed}s"
        if {$elapsed > $threshold_sec} {
            puts "VERDICT=fail (${elapsed}s > threshold ${threshold_sec}s)"
            exit 1
        }
        puts "VERDICT=pass"
        exit 0
    }
    "Kernel panic" {
        puts "VERDICT=fail (kernel panic)"
        exit 1
    }
    "mountroot>" {
        puts "VERDICT=fail (dropped to mountroot — check loader.conf UART console setting)"
        exit 1
    }
    eof {
        puts "VERDICT=fail (serial connection closed unexpectedly)"
        exit 1
    }
    timeout {
        set elapsed [expr {[clock seconds] - $t0}]
        puts "TIMEOUT after ${elapsed}s (threshold ${threshold_sec}s)"
        puts "VERDICT=fail"
        exit 1
    }
}
