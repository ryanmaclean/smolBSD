# Per spec §11 (secrets handling): ephemeral envelope files MUST NOT be tracked
var/run/

# Spool is an operational audit trail — contains IPs, instance IDs, credentials.
# Do not track in public repos. Use var/run/spool-archive/ for long-term storage.
var/mail/spool
var/mail/spool.*

# Spool lock files (future, when multi-coordinator is in scope)
var/mail/*.lock

# Per-task HALT envelopes — ephemeral FSM signaling per spec §11
var/mail/HALT
var/mail/HALT.*

# Build artifacts (Phase I onward — qcow2/raw images are large + reproducible)
build/
*.qcow2
*.raw
*.vmdk

# Claude Code agent worktrees and session data
.claude/

# Editor / OS detritus
.DS_Store
*.swp
*.swo
*~

# jj-internal: do not check the .jj/working-copy contents into git via colocated repo
# (jj manages this on its own; this is a defense-in-depth comment)

# Internal hostname denylist for the pre-push guard — never commit
var/private-hostnames.txt
