subject  = "decision table covers all 6 reply categories named in acceptance"
expected = "rows for: pass+verified, pass+probe-failed, fail, blocked, no-reply, malformed"
probe    = "awk '/^rules = \\[/,/^\\]/' var/mail/spool | grep -c 'category ='"
evidence = "decision_table.rules has 7 entries — the spec's single 'blocked' category is split into 'blocked+unblocker-named' (auto-retry) and 'blocked+no-unblocker' (immediate escalate) because they fire different state transitions. All 6 acceptance-gate categories are present and dispositive."
