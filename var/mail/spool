# ----------------------------------------------------------------------------
# §12 Retry policy — coordinator-side state machine.
# Mechanical: every reply category maps to exactly one action. No per-case
# judgement. Coordinator is a state-machine interpreter, not a planner.
# ----------------------------------------------------------------------------

[summary]
max_attempts   = 3
backoff        = "fibonacci-60s-cap-300s"
escalation_to  = "D3 channel — write [HALT] message + var/mail/HALT marker per design-d3.ops"
categories     = 6
trust_anchor   = "fleet-eval probe is the source of truth, not X-Verdict header"

[state_machine]
# DOT digraph — render with `dot -Tpng` if needed; readable as ASCII too.
diagram = """
digraph retry_policy {
  rankdir=LR;
  node [shape=box, style=rounded, fontname=\"JetBrains Mono\"];

  DISPATCHED   [label=\"DISPATCHED\\n(request appended\\nto spool)\"];
  AWAITING     [label=\"AWAITING_REPLY\\n(timer running)\"];
  HARVEST      [label=\"HARVEST\\n(reply parsed)\"];
  VERIFY       [label=\"VERIFY\\n(fleet-eval claims)\"];
  DONE         [label=\"DONE\", shape=doublecircle, color=green];
  RETRY_QUEUED [label=\"RETRY_QUEUED\\n(backoff timer)\"];
  ESCALATE     [label=\"ESCALATE\\n(D3 halt protocol)\", color=red];

  DISPATCHED   -> AWAITING       [label=\"msg written\"];
  AWAITING     -> HARVEST        [label=\"reply present\\n+ well-formed\"];
  AWAITING     -> RETRY_QUEUED   [label=\"timeout (no-reply)\\nattempt < 3\"];
  AWAITING     -> ESCALATE       [label=\"timeout\\nattempt = 3\"];

  HARVEST      -> RETRY_QUEUED   [label=\"malformed\\nattempt < 3\"];
  HARVEST      -> ESCALATE       [label=\"malformed\\nattempt = 3\"];
  HARVEST      -> VERIFY         [label=\"verdict=pass\\n+ claims present\"];
  HARVEST      -> RETRY_QUEUED   [label=\"verdict=fail\\nattempt < 3\"];
  HARVEST      -> ESCALATE       [label=\"verdict=fail\\nattempt = 3\"];
  HARVEST      -> RETRY_QUEUED   [label=\"verdict=blocked\\n+ unblocker named\\nattempt < 3\"];
  HARVEST      -> ESCALATE       [label=\"verdict=blocked\\nno unblocker\\nOR attempt = 3\"];

  VERIFY       -> DONE           [label=\"all probes PASS\"];
  VERIFY       -> RETRY_QUEUED   [label=\"any probe FAIL\\nattempt < 2\"];
  VERIFY       -> ESCALATE       [label=\"any probe FAIL\\nattempt = 2\"];

  RETRY_QUEUED -> DISPATCHED     [label=\"backoff elapsed\\n(fib seconds)\\n+ prior failure\\ninlined in [brief]\"];
}
"""

# ASCII fallback — same machine, line-based.
ascii = """
[DISPATCHED] --append--> [AWAITING_REPLY]
   |
   |--reply present, parses OK--> [HARVEST]
   |--timeout (no reply)---------> [RETRY_QUEUED]  if attempts<3
   |                            -> [ESCALATE]      if attempts=3
   |
[HARVEST] decides by (verdict, attestation, attempt#):
   pass + claims-present  -> [VERIFY]
   pass + claims-missing  -> treat as malformed
   fail                   -> RETRY if attempts<3 else ESCALATE
   blocked + unblocker    -> RETRY if attempts<3 else ESCALATE
   blocked + no-unblocker -> ESCALATE immediately (no retry)
   malformed/unparseable  -> RETRY if attempts<3 else ESCALATE

[VERIFY] runs fleet-eval verify on every [[claims]] block:
   all PASS               -> [DONE]
   any FAIL/INCONCLUSIVE  -> RETRY if probe_attempts<2 else ESCALATE
                             (probe-disagreement budget is HALF the
                              normal retry budget — see rationale)

[RETRY_QUEUED] sleeps fib(attempt) seconds then re-dispatches with the
prior reply's failure pasted into the new request's [brief].
"""

states = [
  "DISPATCHED",
  "AWAITING_REPLY",
  "HARVEST",
  "VERIFY",
  "RETRY_QUEUED",
  "DONE",
  "ESCALATE",
]

# ----------------------------------------------------------------------------
# Decision table — one row per reply category named in acceptance gate.
# Coordinator implements as a switch/match statement; no judgement.
# ----------------------------------------------------------------------------

[decision_table]
schema = ["category", "predicate", "next_state", "max_retries", "rationale"]

rules = [
  { category = "pass+verified",
    predicate = "verdict='pass' AND every [[claims]].verdict='pass' under fleet-eval re-probe",
    next_state = "DONE",
    max_retries = 0,
    rationale = "Self-report and independent probe agree. Trust established. Terminate task." },

  { category = "pass+probe-failed",
    predicate = "verdict='pass' AND any [[claims]] re-probe returns FAIL or INCONCLUSIVE",
    next_state = "RETRY_QUEUED",
    max_retries = 1,
    rationale = "Agent claims success, fleet-eval disagrees. One retry only — half the normal budget — because the disagreement is either (a) a flaky probe, fixable by re-running, or (b) the agent is hallucinating verification, in which case more agent retries just produce more hallucination. Retry payload MUST inline the failed probe output verbatim into [brief] so the agent sees its own contradiction. If second attempt also probe-fails, escalate: human or D3 must adjudicate whether agent or probe is wrong." },

  { category = "fail",
    predicate = "verdict='fail'",
    next_state = "RETRY_QUEUED",
    max_retries = 3,
    rationale = "Agent reports honest failure. First retry covers transient flakes (rate-limit, network blip, cache-cold prompt). Second retry with the failure summary inlined gives the agent its own prior diagnosis as context. Third retry is the last shot. Beyond 3, the failure is structural (spec defect, missing capability)." },

  { category = "blocked+unblocker-named",
    predicate = "verdict='blocked' AND reply contains 'blocked_by' field naming a path/credential/context_pointer the coordinator can supply",
    next_state = "RETRY_QUEUED",
    max_retries = 3,
    rationale = "Agent identified a missing input. Coordinator satisfies it (e.g., adds the path to context_pointers, requests a credential via D1's secret-materialize.nu) then re-dispatches. Same retry budget as 'fail' because each retry must change the request payload — pure resend with no change is forbidden." },

  { category = "blocked+no-unblocker",
    predicate = "verdict='blocked' AND no actionable 'blocked_by' field",
    next_state = "ESCALATE",
    max_retries = 0,
    rationale = "Agent thinks the spec itself is wrong or the world is in the wrong state. Retrying the same spec is muri (Toyota Way: unreasonable strain). Escalate to D3 channel for human/operator judgement on spec change." },

  { category = "no-reply",
    predicate = "no message with In-Reply-To matching the dispatch Message-ID after timeout (default: 30 min for prototype, configurable)",
    next_state = "RETRY_QUEUED",
    max_retries = 3,
    rationale = "Subagent crashed, ran out of budget, or never started. Same 3-attempt budget as 'fail'. Each retry doubles the budget_tokens up to a per-task cap (default 200k) on the assumption that budget exhaustion is the most common cause of no-reply." },

  { category = "malformed",
    predicate = "reply present but mbox parse fails OR TOML body invalid OR required fields (task_id, verdict) missing OR verdict='pass' without [[claims]] when attestation_required=true",
    next_state = "RETRY_QUEUED",
    max_retries = 3,
    rationale = "Subagent produced output but violated the envelope contract. Retry with the parser error pasted into [brief.format_violation] so the agent self-corrects. If a fresh subagent on a fresh dispatch can't produce valid envelope after 3 attempts, the agent type itself is unsuited to the task — escalate." },
]

# ----------------------------------------------------------------------------
# Backoff — Fibonacci, capped at 300s, with cache-window awareness.
# ----------------------------------------------------------------------------

[backoff]
strategy      = "fibonacci"
sequence      = [60, 60, 120]   # seconds before attempt 2, 3, escalation-write
cap_seconds   = 300
max_attempts  = 3
attempts_after_initial = 2      # i.e. up to 2 retries -> 3 total dispatches

rationale = """
Why Fibonacci, not exponential:
  - Each retry costs 60-100k tokens of agent budget. Exponential
    (60->120->240->480) burns the prompt-cache TTL (5 min, per CLAUDE.md
    ScheduleWakeup guidance) on every step, paying cache-miss cost twice
    in three retries.
  - Fibonacci grows slower (60->60->120->180->300) and the doubled-60 at
    the start lets a transient rate-limit or network blip resolve in the
    cheapest window while the prompt cache is still warm.
  - Cap at 300s aligns with the 5-min cache TTL; beyond that, escalation
    is cheaper than waiting.

Why max_attempts = 3:
  - 1st attempt: baseline. Establishes the failure mode.
  - 2nd attempt: proves the failure isn't a transient (cache-cold,
    rate-limit, flaky shell hook). Includes the 1st failure summary in
    [brief].
  - 3rd attempt: last shot. Includes both prior failure summaries + an
    explicit instruction 'two prior attempts failed; if you cannot pass,
    return verdict=blocked with a named blocker rather than fail again'.
  - Beyond 3: the failure is structural (spec defect, missing capability,
    environment gap). More retries = muri. Escalate.

Why probe-disagreement gets only 1 retry (half budget):
  - If fleet-eval and the agent disagree, more agent retries don't break
    the tie — they produce more agent output. Either the probe is wrong
    (operator must fix) or the agent is hallucinating (operator must
    adjust). Both resolutions require human/D3 input, so escalate fast.

Cross-D1 hook:
  - Per D1 next_recommended: fingerprint-mismatch in reply.secrets_consumed
    is treated as hard-fail with NO auto-retry. That overrides the 'fail'
    row above for the specific case of credential-fingerprint mismatch:
    skip RETRY_QUEUED, go straight to ESCALATE. This is mechanical (one
    extra predicate check before the table lookup), not a judgement call.
"""

# ----------------------------------------------------------------------------
# Retry payload contract — what changes between attempt N and N+1.
# Without this the retries are pure muda (Toyota Way: waste).
# ----------------------------------------------------------------------------

[retry_payload]
# Each retry MUST mutate the request payload. Pure resend is forbidden.
must_inline_in_brief = [
  "prior_attempt_msgid       — Message-ID of the failed reply (or NIL for no-reply)",
  "prior_attempt_failure     — verdict + first 500 chars of failure evidence",
  "prior_attempt_count       — integer, 1 or 2",
  "format_violation          — parser error if category=malformed",
  "probe_disagreement        — fleet-eval probe output if category=pass+probe-failed",
]
budget_escalation = """
For category='no-reply' only: budget_tokens doubles per retry, capped at
200000. Other categories keep the original budget.
"""
new_msgid_pattern = "Each retry gets a fresh Message-ID: <task-XXX.coord.r{N}@smolbsd.local>"
attempt_header    = "X-Attempt: <N>  (1-indexed; coord state reconstructable from spool alone)"

